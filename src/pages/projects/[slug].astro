---
import { projects } from '@config';
import type { Project } from '@types';
import MainLayout from '@views/layouts/MainLayout.astro';
import { createMarkdownProcessor } from '@astrojs/markdown-remark';

export async function getStaticPaths() {
  return projects.map((project: Project) => {
    return {
      params: {
        slug: project.slug,
      },
      props: {
        project,
      },
    };
  });
}

const { project } = Astro.props;

let content = '';
if (project.docs) {
  try {
    const response = await fetch(project.docs);
    if (response.ok) {
      let markdown = await response.text();

      // Replace relative image paths with absolute URLs
      const baseUrl = project.docs.substring(0, project.docs.lastIndexOf('/') + 1);
      markdown = markdown.replace(/src="([^"]+)"/g, (match, src) => {
        if (!src.startsWith('http')) {
          return `src="${baseUrl}${src}"`;
        }
        return match;
      });

      const processor = await createMarkdownProcessor({
        shikiConfig: {
          themes: {
            light: 'github-light',
            dark: 'github-dark',
          },
          wrap: true,
        },
      });
      const result = await processor.render(markdown);
      content = result.code;
    } else {
      content = '<p>Failed to load documentation.</p>';
    }
  } catch (error) {
    console.error(error);
    content = '<p>Error loading documentation.</p>';
  }
} else {
  content = '<p>No documentation available.</p>';
}
---

<MainLayout title={project.name}>
  <section class="relative z-20 mx-auto my-12 max-w-4xl px-7 lg:px-0">
    <div class="prose dark:prose-invert max-w-none" set:html={content} />
  </section>
</MainLayout>
