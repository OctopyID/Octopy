---
import { projects } from '@config';
import type { Project } from '@types';
import MainLayout from '@views/layouts/MainLayout.astro';
import { createMarkdownProcessor } from '@astrojs/markdown-remark';
import { Star, ExternalLink } from 'lucide-vue-next';
import { github } from '../../helpers';

export async function getStaticPaths() {
  return projects.map((project: Project) => {
    return {
      params: {
        slug: project.slug,
      },
      props: {
        project,
      },
    };
  });
}

const { project } = Astro.props;

let content = '';
let stars = 0;
let archived = false;

if (project.link && project.link.includes('github.com')) {
  const repo = project.link.replace('https://github.com/', '');
  const data = await github(repo);

  if (data) {
    stars = data.stargazers_count;
    archived = data.archived;
  }
}

if (project.docs) {
  try {
    const response = await fetch(project.docs);
    if (response.ok) {
      const markdown = await response.text();

      const processor = await createMarkdownProcessor({
        shikiConfig: {
          themes: {
            light: 'github-light',
            dark: 'github-dark',
          },
          wrap: true,
        },
      });
      const result = await processor.render(markdown);
      content = result.code;

      // Replace relative image paths with absolute URLs
      const baseUrl = project.docs.substring(0, project.docs.lastIndexOf('/') + 1);
      content = content.replace(/src="([^"]+)"/g, (match, src) => {
        if (!src.startsWith('http') && !src.startsWith('//') && !src.startsWith('data:')) {
          return `src="${baseUrl}${src}"`;
        }
        return match;
      });

      // Replace relative links with absolute GitHub blob URLs
      let blobUrl = baseUrl;
      if (baseUrl.includes('raw.githubusercontent.com')) {
        blobUrl = baseUrl.replace('raw.githubusercontent.com', 'github.com');
        const parts = blobUrl.split('/');
        if (parts.length >= 6) {
          parts.splice(5, 0, 'blob');
          blobUrl = parts.join('/');
        }
      }

      content = content.replace(/href="([^"]+)"/g, (match, href) => {
        if (!href.startsWith('http') && !href.startsWith('//') && !href.startsWith('#') && !href.startsWith('mailto:')) {
          return `href="${blobUrl}${href}"`;
        }
        return match;
      });

    } else {
      content = '<p>Failed to load documentation.</p>';
    }
  } catch (error) {
    console.error(error);
    content = '<p>Error loading documentation.</p>';
  }
} else {
  content = '<p>No documentation available.</p>';
}
---

<MainLayout title={project.name}>
  <section class="relative z-20 mx-auto my-12 max-w-4xl px-7 lg:px-0">
    <div class="mb-8 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <h1 class="text-3xl font-bold text-slate-900 dark:text-slate-100">{project.name}</h1>
        {
          archived && (
            <span class="rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-medium text-amber-800 dark:bg-amber-900 dark:text-amber-300">
              Archived
            </span>
          )
        }
      </div>
      <div class="flex items-center gap-4">
        <div class="flex items-center gap-2 rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm font-medium text-slate-700 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300">
          <Star class="h-4 w-4 text-amber-400 fill-amber-400" />
          <span>{stars}</span>
        </div>
        {
          project.link && (
            <a
              href={project.link}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white transition hover:bg-slate-800 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-200"
            >
              <span>Visit Link</span>
              <ExternalLink class="h-4 w-4" />
            </a>
          )
        }
      </div>
    </div>
    <div class="prose dark:prose-invert max-w-none [&_.octopy-hidden]:hidden [&>h1:first-of-type]:hidden" set:html={content} />
  </section>
</MainLayout>
