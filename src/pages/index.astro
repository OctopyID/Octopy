---
import { Image } from 'astro:assets';
import { Icon, Link, Separator } from '@views/commons';
import MainLayout from '@views/layouts/MainLayout.astro';
import Portrait from '../../public/images/portrait.webp';
import Projects from '@views/Projects.astro';
import Writings from '@views/Writings.astro';
---

<MainLayout title="Supian M">
  <div class="relative z-20 mx-auto mt-12 w-full max-w-4xl px-7 select-none md:mt-24 lg:mt-32 xl:px-0">
    <div class="flex flex-col items-center md:flex-row">
      <div class="relative w-full md:w-1/2">
        <h1 class="mb-5 text-4xl leading-tight font-bold md:text-4xl lg:text-5xl dark:text-white">
          Hello, I'm Supian M.
        </h1>

        <p class="mb-6 text-base text-gray-600 dark:text-gray-400">
          I'm a developer based in Banjarbaru, Indonesia.
          <br class="hidden lg:block" />
          with expertise in web development and server administration.
        </p>

        <p class="mb-2 font-semibold text-gray-800 dark:text-gray-200">I can help you out with:</p>

        <ul class="list-inside list-disc space-y-[3px] py-2 text-sm text-gray-500 dark:text-gray-400">
          <li>Vue & Electron Development</li>
          <li>Laravel Development</li>
          <li>Docker & Containerization</li>
          <li>Mail Server Configuration</li>
          <li>Linux Server Administration</li>
          <li>and more...</li>
        </ul>

        <Link href="https://github.com/SupianIDz" target="_blank"> Follow me on GitHub</Link>
      </div>

      <div
        class="relative mt-10 hidden w-full justify-end md:mt-0 md:flex md:w-1/2 md:translate-y-4 md:pl-10 xl:translate-y-0"
      >
        <div class="relative z-50 w-full">
          <div
            class="absolute top-0 bottom-0 z-40 h-16 w-16 -translate-x-6 -translate-y-1/2 rounded-full lg:top-auto lg:-translate-y-[330px]"
          >
            <div
              class="relative z-20 flex h-full w-full items-center justify-center rounded-full border-8 border-white bg-gray-100 text-2xl dark:border-gray-900 dark:bg-gray-900"
            >
              <span
                class="flex h-full w-full items-center justify-center rounded-full border border-dashed border-gray-400 bg-white dark:border-gray-400 dark:bg-gray-900"
              >
                👋
              </span>
            </div>
          </div>
          <div class="relative z-30 px-10">
            <Image
              src={Portrait}
              loading="eager"
              decoding="auto"
              class="relative z-30 mx-auto aspect-790/1189 w-full md:max-w-md dark:-translate-y-0.5"
              alt="Supian M"
            />
          </div>
          <div
            class="absolute right-0 bottom-0 z-20 h-full w-full translate-x-0 -translate-y-px rounded-2xl border border-dashed border-gray-400 bg-linear-to-r from-white via-gray-50 to-white lg:h-[420px] dark:border-gray-400 dark:from-gray-900 dark:via-gray-950 dark:to-gray-900"
          >
          </div>
        </div>
      </div>
    </div>
  </div>

  <Separator text="Check out my projects" />

  <Projects limit={6} />

  <Separator text="Some of my writing" />

  <Writings limit={3} />
</MainLayout>
