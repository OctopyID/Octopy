---
import { Image } from 'astro:assets';
import { Icon, Link, Separator } from '../views/commons';
import MainLayout from '@views/layouts/MainLayout.astro';
import Portrait from '../../public/images/portrait.png';
import Projects from '@views/Projects.astro';
import Writings from '@views/Writings.astro';
---
<MainLayout title="Supian M">
    <div class="relative z-20 w-full max-w-4xl mx-auto mt-12 px-7 md:mt-24 lg:mt-32 xl:px-0 select-none">
        <div class="flex flex-col items-center md:flex-row">
            <div class="relative w-full md:w-1/2">
                <h1 class="mb-5 text-4xl font-bold leading-tight md:text-4xl lg:text-5xl dark:text-white">
                    Hello, I'm Supian M.
                </h1>

                <p class="mb-6 text-base text-gray-600 dark:text-gray-400">
                    I'm a developer based in Banjarbaru, Indonesia.
                    <br class="hidden lg:block" />
                    with expertise in web development and server administration.
                </p>

                <p class="mb-2 font-semibold text-gray-800 dark:text-gray-200">
                    I can help you out with:
                </p>

                <ul class="py-2 space-y-[3px] text-sm list-disc list-inside text-gray-500 dark:text-gray-400">
                    <li>Vue & Electron Development</li>
                    <li>Laravel Development</li>
                    <li>Docker & Containerization</li>
                    <li>Mail Server Configuration</li>
                    <li>Linux Server Administration</li>
                    <li>and more...</li>
                </ul>

                <Link href="https://github.com/SupianIDz" target="_blank">
                    Follow me on GitHub
                </Link>
            </div>

            <div class="relative justify-end hidden w-full mt-10 md:flex md:pl-10 md:w-1/2 md:mt-0 md:translate-y-4 xl:translate-y-0">
                <div class="relative z-50 w-full">
                    <div class="absolute bottom-0 z-40 w-16 h-16 -translate-x-6 -translate-y-1/2 lg:top-auto top-0 lg:-translate-y-[330px] rounded-full">
                        <div
                            class="relative z-20 flex items-center justify-center w-full h-full text-2xl border-8 border-white rounded-full dark:border-gray-900 bg-gray-100 dark:bg-gray-900">
                            <span
                                class="flex items-center justify-center w-full h-full bg-white border border-dashed rounded-full dark:bg-gray-900 border-gray-300 dark:border-gray-700">
                                👋
                            </span>
                        </div>
                    </div>
                    <div class="relative z-30 px-10">
                        <Image
                            src={Portrait}
                            loading="eager"
                            decoding="auto"
                            class="relative z-30 w-full aspect-790/1189 md:max-w-md mx-auto dark:-translate-y-0.5"
                            alt="Supian M" />
                    </div>
                    <div
                        class="absolute bottom-0 right-0 z-20 w-full h-full lg:h-[420px] translate-x-0 -translate-y-px border border-dashed rounded-2xl bg-linear-to-r dark:from-gray-900 dark:via-gray-950 dark:to-gray-900 from-white via-gray-50 to-white border-gray-300 dark:border-gray-700">
                    </div>
                </div>
            </div>
        </div>
    </div>

    <Separator text="Check out my projects"></Separator>

    <Projects></Projects>

    <Separator text="Some of my writing"></Separator>

    <Writings></Writings>
</MainLayout>