---
import { projects } from '@config';
import type { Project as Contract } from '@types';

import Project from '@views/Project.astro';
import Heading from '@views/commons/Heading.astro';
import MainLayout from '@views/layouts/MainLayout.astro';
---

<MainLayout title="My Projects">
  <section class="relative z-20 mx-auto my-12 max-w-4xl px-7 select-none lg:px-0">
    <Heading title="My Projects">
      I love creating libraries, building custom packages, and developing applications that solve real-world problems.
      Each project is a blend of creativity and functionality — always crafted with clean code and a focus on user
      experience. This page is constantly evolving as I'm always exploring new ideas and working on something exciting.
    </Heading>

    <div class="z-50 my-8 grid w-full grid-cols-1 items-stretch gap-7 sm:grid-cols-3 sm:gap-5">
      {
        projects.map((project: Contract) => {
          return <Project name={project.name} desc={project.desc} prev={project.prev} slug={project.slug} />;
        })
      }
    </div>
  </section>
</MainLayout>
