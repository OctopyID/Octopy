---
import type { Project as Contract } from '@types';
import { projects } from '@config';
import { Link } from './commons';
import Project from './Project.astro';

const { limit = null } = Astro.props;
---

<section class="mx-auto max-w-4xl px-7 lg:px-0">
  <h2 class="text-2xl leading-10 font-bold tracking-tight text-slate-900 dark:text-slate-100">My Projects</h2>
  <p class="mb-6 text-base text-slate-600 dark:text-slate-400">
    Here are some of my recent projects. I'm always working on something new, so check back often!
  </p>
  <div class="mt-7 grid w-full grid-cols-1 items-stretch gap-7 sm:grid-cols-2 md:grid-cols-3">
    {
      projects
        .slice(0, limit ? limit : projects.length)
        .map((project: Contract) => (
          <Project name={project.name} desc={project.desc} prev={project.prev} link={project.link} />
        ))
    }
  </div>

  <div class="flex w-full items-center justify-center py-5">
    <Link href="/projects"> View All My Projects</Link>
  </div>
</section>
