---
const { logo, date, role, comp, desc } = Astro.props;
---

<div class="relative flex flex-col justify-start pl-12">
  <div
    class="absolute top-0 left-0 z-40 flex h-14 w-14 -translate-x-1/2 items-center justify-center rounded-full border border-slate-300 bg-white dark:border-slate-400 dark:bg-slate-950"
  >
    <img src={logo} alt={comp} class="h-8 w-8 object-contain" />
  </div>

  <p class="trackign-widest text-xs text-slate-500 uppercase dark:text-slate-400">
    {date}
  </p>
  <h3 class="my-1 text-lg font-bold dark:text-slate-100">{role}</h3>
  <p class="mb-1 text-sm font-medium dark:text-slate-300">{comp}</p>
  <p class="text-sm font-light text-slate-600 dark:text-slate-400">
    {desc}
  </p>
</div>
