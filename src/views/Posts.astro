---
import type { Post } from '../types';
import { excerpt } from '../helpers';
import moment from 'moment';
import type { ContentEntryModule } from 'astro';
const { posts } = Astro.props;

const loop = posts.map((post: any) => {
  return {
    ...(post.data || {}),
    link: `/posts/${post.id}`,
    date: post.date.format('MMM D, YYYY'),
    excerpt: excerpt(post!.body ?? ''),
  };
});
---

{
  loop.map((post: Post) => {
    return (
      <div
        class="group relative cursor-pointer rounded-2xl border border-dashed border-transparent p-7"
        onclick={`location.href = '${post.link}'`}
      >
        <div class="absolute inset-0 z-20 h-full w-full rounded-2xl border border-dashed border-slate-400 bg-white duration-300 ease-out group-hover:-translate-x-1 group-hover:-translate-y-1 dark:border-slate-400 dark:bg-slate-900" />
        <div class="absolute inset-0 z-10 h-full w-full rounded-2xl border border-dashed border-slate-400 duration-300 ease-out group-hover:translate-x-1 group-hover:translate-y-1 dark:border-slate-400" />
        <div class="relative z-30 duration-300 ease-out group-hover:-translate-x-1 group-hover:-translate-y-1">
          <h2 class="mb-3 flex items-center">
            <a href={post.link} class="text-base leading-tight font-bold tracking-tight sm:text-lg dark:text-slate-100">
              {post.title}
            </a>
          </h2>
          <p class="text-sm text-slate-600 dark:text-slate-400">
            <span>{post.excerpt}</span>
          </p>
          <div class="mt-2.5 text-xs font-medium text-slate-800 dark:text-slate-300">Published on {post.date}</div>
        </div>
      </div>
    );
  })
}
