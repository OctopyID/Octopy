---
import type { Post } from '../types';
import { excerpt } from '../helpers';
import moment from 'moment';
import type { ContentEntryModule } from 'astro';
const { posts } = Astro.props;

const loop = posts.map((post: unknown) => {
  return {
    ...(post.data || {}),
    link: `/posts/${post.id}`,
    date: post.date.format('MMM D, YYYY'),
    excerpt: excerpt(post!.body ?? ''),
  };
});
---

{
  loop.map((post: Post) => {
    return (
      <div
        class="group relative cursor-pointer rounded-2xl border border-dashed border-transparent p-7"
        onclick={`location.href = '${post.link}'`}
      >
        <div class="absolute inset-0 z-20 h-full w-full rounded-2xl border border-dashed border-gray-400 bg-white duration-300 ease-out group-hover:-translate-x-1 group-hover:-translate-y-1 dark:border-gray-400 dark:bg-gray-900" />
        <div class="absolute inset-0 z-10 h-full w-full rounded-2xl border border-dashed border-gray-400 duration-300 ease-out group-hover:translate-x-1 group-hover:translate-y-1 dark:border-gray-400" />
        <div class="relative z-30 duration-300 ease-out group-hover:-translate-x-1 group-hover:-translate-y-1">
          <h2 class="mb-3 flex items-center">
            <a href={post.link} class="text-base leading-tight font-bold tracking-tight sm:text-lg dark:text-gray-100">
              {post.title}
            </a>
          </h2>
          <p class="text-sm text-gray-600 dark:text-gray-400">
            <span>{post.excerpt}</span>
          </p>
          <div class="mt-2.5 text-xs font-medium text-gray-800 dark:text-gray-300">Posted on {post.date}</div>
        </div>
      </div>
    );
  })
}
