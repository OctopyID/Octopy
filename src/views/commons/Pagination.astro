---
import Icon from './Icon.astro';
const { page } = Astro.props;

const pageNums = Array.from({ length: page.lastPage }, (_, i) => {
  return i + 1;
});

const PrevTag = page.url.prev ? 'a' : 'span';
const NextTag = page.url.next ? 'a' : 'span';
---

<nav class="mt-8 flex items-center justify-center gap-x-1" aria-label="Pagination">
  <!-- Prev Button -->
  <PrevTag
    href={page.url.prev}
    class="inline-flex min-h-[38px] min-w-[38px] items-center justify-center gap-x-1.5 rounded-lg px-2.5 py-2 text-sm text-gray-800 hover:bg-gray-100 focus:bg-gray-100 focus:outline-none disabled:pointer-events-none disabled:opacity-50 dark:text-gray-100 dark:hover:bg-white/10 dark:focus:bg-white/10"
    aria-label="Previous"
    aria-disabled={!page.url.prev}
    {...page.url.prev ? {} : { disabled: true }}
  >
    <Icon name="Prev" />
    <span>Prev</span>
  </PrevTag>

  <!-- Page Numbers -->
  <div class="flex items-center gap-x-1">
    {
      pageNums.map((num) => (
        <a
          href={`/posts/${num === 1 ? '' : num + '/'}`}
          class={`flex min-h-[38px] min-w-[38px] items-center justify-center rounded-lg px-3 py-2 text-sm ${
            num === page.currentPage
              ? 'bg-gray-200 text-gray-800 focus:bg-gray-300 dark:bg-white/10 dark:text-gray-100 dark:focus:bg-gray-500'
              : 'text-gray-800 hover:bg-gray-100 focus:bg-gray-100 dark:text-gray-100 dark:hover:bg-white/10 dark:focus:bg-white/10'
          }`}
          aria-current={num === page.currentPage ? 'page' : undefined}
        >
          {num}
        </a>
      ))
    }
  </div>

  <!-- Next Button -->
  <NextTag
    href={page.url.next}
    class="inline-flex min-h-[38px] min-w-[38px] items-center justify-center gap-x-1.5 rounded-lg px-2.5 py-2 text-sm text-gray-800 hover:bg-gray-100 focus:bg-gray-100 focus:outline-none disabled:pointer-events-none disabled:opacity-50 dark:text-gray-100 dark:hover:bg-white/10 dark:focus:bg-white/10"
    aria-label="Next"
    aria-disabled={!page.url.next}
    {...page.url.next ? {} : { disabled: true }}
  >
    <span>Next</span>
    <Icon name="Next" />
  </NextTag>
</nav>
