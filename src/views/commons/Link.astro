---
const { ...rest } = Astro.props;
---

<a
  {...rest}
  class="mt-5 inline-flex w-auto rounded-md border border-dashed border-slate-900 bg-slate-900 px-4 py-2 text-xs font-semibold text-slate-100 duration-300 ease-out hover:border-slate-400 hover:bg-white hover:text-slate-900 dark:border-solid dark:bg-white dark:text-slate-900 dark:hover:border-slate-300 dark:hover:bg-slate-900 dark:hover:text-white"
>
  <slot />
</a>
