  class="mt-5 inline-flex w-auto rounded-md border border-dashed border-gray-900 bg-gray-900 px-4 py-2 text-xs font-semibold text-gray-100 duration-300 ease-out hover:border-gray-400 hover:bg-white hover:text-gray-900 dark:border-solid dark:bg-white dark:text-gray-900 dark:hover:border-gray-300 dark:hover:bg-gray-900 dark:hover:text-white"
>
  <slot />
</a>
