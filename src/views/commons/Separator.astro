---
const { text } = Astro.props;
---

<div class="relative my-14 select-none">
    <div class="relative w-full pl-5 overflow-x-hidden md:pl-0">
        <div
            class="absolute w-full h-px bg-linear-to-r from-transparent to-white md:from-white dark:from-transparent dark:to-gray-900 md:dark:from-gray-900 md:via-transparent md:dark:via-transparent md:to-white md:dark:to-gray-900">
        </div>
        <div class="w-full h-px border-t border-dashed border-gray-500 dark:border-gray-400"></div>
    </div>
    <div
        class="absolute flex items-center justify-center w-auto h-auto px-3 py-1.5 uppercase tracking-widest space-x-1 text-[0.6rem] md:-translate-x-1/2 -translate-y-1/2 border  border-dashed rounded-full bg-white border-gray-500 dark:border-gray-400 dark:bg-gray-900 text-gray-500 dark:text-gray-400 left-0 md:ml-0 ml-5 md:left-1/2  shadow-xs">
        <p class="leading-none">{text}</p>
        <div class="flex items-center justify-center w-5 h-5 translate-x-1 border border-dashed rounded-full border-gray-500 dark:border-gray-400">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                 stroke-linejoin="round" class="size-3">
                <path d="M12 5v14" />
                <path d="m19 12-7 7-7-7" />
            </svg>
        </div>
    </div>
</div>
