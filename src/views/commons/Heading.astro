---
const { title } = Astro.props;
---

<div class="relative z-20 mx-auto w-full lg:mx-0">
  <h2 class="text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl lg:text-4xl dark:text-gray-100">
    {title}
  </h2>
  <p
    class="mt-3 text-sm leading-6 text-gray-600 sm:mt-4 sm:text-base sm:leading-7 lg:mt-6 lg:text-lg lg:leading-8 dark:text-gray-400"
  >
    <slot />
  </p>
</div>
