---
import _ from 'lodash';
import SquareLine from './SquareLine.astro';

const boxes = 6;
---

<div class="absolute w-full h-auto" style="z-index:-1">
    <div class="absolute top-0 left-0 w-1/2 h-auto bg-gray-100 dark:bg-gray-900">
        <div class="absolute inset-0 z-30 w-full h-full pointer-events-none bg-linear-to-tl from-white dark:from-gray-900 from-50% via-90% to-100% via-transparent to-transparent">
        </div>
        <div class="flex flex-col w-full h-full border-l divide-y divide-dashed divide-gray-300 dark:divide-gray-700 border-gray-300 dark:border-gray-900">
            {
                _.times(boxes, () => (
                    <SquareLine />
                ))
            }
        </div>
    </div>

    <div class="absolute top-0 right-0 w-1/2 h-auto bg-gray-100 dark:bg-gray-900">
        <div class="absolute inset-0 z-30 w-full h-full pointer-events-none bg-linear-to-tr from-white dark:from-gray-900 from-50% via-90% to-100% via-transparent to-transparent">
        </div>
        <div class="flex flex-col w-full h-full border-l divide-y divide-dashed divide-gray-300 dark:divide-gray-700 border-gray-300 dark:border-gray-900">
            {
                _.times(boxes, () => (
                    <SquareLine />
                ))
            }
        </div>
    </div>
</div>

<slot></slot>
