---
import '@style/main.css';
import SquareLines from './partials/SquareLines.astro';
import Header from '@views/layouts/partials/vue/Header.vue';
import Footer from '@views/layouts/partials/vue/Footer.vue';
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{title} - Octopy ID</title>
        <link rel="icon" type="image/x-icon" href="/favicon.svg">

        <script is:inline>
            // prevent flickering
            if (typeof Storage !== 'undefined') {
                document.documentElement.classList.toggle('dark', localStorage.getItem('vueuse-color-scheme') === 'dark');
            }
        </script>
    </head>
    <body class="bg-white dark:bg-gray-900">
        <SquareLines>
            <Header client:only="vue"></Header>
            <slot></slot>
            <Footer client:only="vue"></Footer>
        </SquareLines>
    </body>
</html>