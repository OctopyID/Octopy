---
import { Image } from 'astro:assets';

const { name, desc, link, prev } = Astro.props;
const Wrapper = link ? 'a' : 'div';
---

<Wrapper href={link} target={link ? "_blank" : undefined} class="group relative flex flex-col items-stretch rounded-2xl p-7 duration-300 ease-out sm:p-3">
  <div
    class="absolute inset-0 z-20 block h-full w-full rounded-2xl border border-dashed border-transparent bg-transparent duration-300 ease-out group-hover:-translate-x-1 group-hover:-translate-y-1 group-hover:border group-hover:border-dashed group-hover:border-gray-500 group-hover:bg-white dark:group-hover:border-gray-400 dark:group-hover:bg-gray-900"
  ></div>
  <div
    class="absolute inset-0 z-10 block h-full w-full rounded-2xl border border-dashed border-gray-500 duration-300 ease-out group-hover:translate-x-1 group-hover:translate-y-1 dark:border-gray-400"
  ></div>
  <div class="relative z-30 block duration-300 ease-out group-hover:-translate-x-1 group-hover:-translate-y-1">
    <div class="block w-full">
      <img src={prev} class="aspect-16/9 h-auto w-full rounded-lg object-cover" alt={name} loading="eager" />
    </div>
    <div class="mt-5 mb-1 block w-full px-1 sm:mt-3">
      <div class="mb-0 flex items-center text-base font-semibold tracking-tight text-gray-900 dark:text-gray-100">
        <span>{name}</span>
      </div>
      <div class="block truncate text-sm text-gray-600 dark:text-gray-400">{desc}</div>
    </div>
  </div>
</Wrapper>
