{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@views/*": [
        "src/views/*"
      ],
      "@style/*": [
        "src/style/*"
      ]
    },
    "jsx": "preserve"
  }
}